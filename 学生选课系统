#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct BiTNode
{
    int   stu_no;            /* 学号（排序关键字）*/
    char  name[10];          /* 姓名 */
    char  course[30];        /* 所选课程名 */
    struct BiTNode *lchild;  /* 左子树 */
    struct BiTNode *rchild;  /* 右子树 */
} BiTNode, *BSTree;

/* 创建二叉排序树，预置题目给的 5 条学生数据 */
void CreateBST(BSTree *pT)
{
    *pT = NULL;

    BiTNode arr[5] = {
        {2001, "高小青", "《人工智能导论》", NULL, NULL},
        {2002, "谢小峰", "《数据结构与算法》", NULL, NULL},
        {2003, "陈小洪", "《计算机网络》", NULL, NULL},
        {2004, "马小玲", "《操作系统原理》", NULL, NULL},
        {2005, "李小彬", "《软件工程导论》", NULL, NULL}
    };

    for (int i = 0; i < 5; i++)
    {
        BiTNode *s = (BiTNode *)malloc(sizeof(BiTNode));
        *s = arr[i];
        s->lchild = s->rchild = NULL;
        InsertBST(pT, s);
    }
    printf("✅ 已加载初始选课数据，BST 创建完成！\n");
}

/* 中序遍历，升序输出全部学生 */
void InOrder(BSTree T)
{
    if (T != NULL)
    {
        InOrder(T->lchild);
        printf("%d\t%s\t%s\n", T->stu_no, T->name, T->course);
        InOrder(T->rchild);
    }
}

/* 按学号查找，找到返回结点指针，否则返回 NULL */
BiTNode* SearchBST(BSTree T, int key)
{
    if (T == NULL || T->stu_no == key)
        return T;
    if (key < T->stu_no)
        return SearchBST(T->lchild, key);
    else
        return SearchBST(T->rchild, key);
}

/* BST 插入结点 s */
int InsertBST(BSTree *pT, BiTNode *s)
{
    if (*pT == NULL)
    {
        *pT = s;
        return 1;
    }
    if (s->stu_no == (*pT)->stu_no)
    {
        printf("⚠️ 该学号已存在，不能重复插入！\n");
        return 0;
    }
    else if (s->stu_no < (*pT)->stu_no)
        return InsertBST(&((*pT)->lchild), s);
    else
        return InsertBST(&((*pT)->rchild), s);
}

/* 删除结点：删除以 p 为根，用 r 接替 p */
void DeleteNode(BSTree *p)
{
    BiTNode *q, *r;
    q = *p;
    if ((*p)->rchild == NULL)
    {
        *p = (*p)->lchild;
        free(q);
    }
    else if ((*p)->lchild == NULL)
    {
        *p = (*p)->rchild;
        free(q);
    }
    else
    {
        q = *p;
        r = (*p)->lchild;
        while (r->rchild != NULL)
        {
            q = r;
            r = r->rchild;
        }
        (*p)->stu_no = r->stu_no;
        strcpy((*p)->name, r->name);
        strcpy((*p)->course, r->course);
        if (q != *p)
            q->rchild = r->lchild;
        else
            q->lchild = r->lchild;
        free(r);
    }
}

/* 删除学号为 key 的学生 */
int DeleteBST(BSTree *pT, int key)
{
    if (*pT == NULL)
        return 0;
    if ((*pT)->stu_no == key)
    {
        DeleteNode(pT);
        return 1;
    }
    else if (key < (*pT)->stu_no)
        return DeleteBST(&((*pT)->lchild), key);
    else
        return DeleteBST(&((*pT)->rchild), key);
}

/* 菜单函数 */
void menu()
{
    printf("\n===== 高校选课二叉排序树管理系统 =====\n");
    printf("1 - 创建 BST（加载初始选课数据）\n");
    printf("2 - 中序遍历，显示全部选课学生\n");
    printf("3 - 按学号查找学生选课信息\n");
    printf("4 - 插入新选课学生\n");
    printf("5 - 删除退课学生（按学号）\n");
    printf("0 - 退出程序\n");
    printf("=======================================\n");
    printf("请输入操作选项：");
}

int main(void)
{
    BSTree T = NULL;
    int op;
    int key;
    BiTNode *s;

    while (1)
    {
        menu();
        scanf("%d", &op);
        switch (op)
        {
            case 1:
                CreateBST(&T);
                break;

            case 2:
                if (T == NULL)
                {
                    printf("⚠️ 树为空，请先创建！\n");
                }
                else
                {
                    printf("\n学号\t姓名\t课程\n");
                    InOrder(T);
                }
                break;

            case 3:
                printf("请输入要查找的学号：");
                scanf("%d", &key);
                {
                    BiTNode *res = SearchBST(T, key);
                    if (res != NULL)
                    {
                        printf("✅ 找到：%d %s %s\n", res->stu_no, res->name, res->course);
                    }
                    else
                    {
                        printf("❌ 未找到该学号学生！\n");
                    }
                }
                break;

            case 4:
                s = (BiTNode *)malloc(sizeof(BiTNode));
                s->lchild = s->rchild = NULL;
                printf("请输入新学生学号：");
                scanf("%d", &s->stu_no);
                printf("请输入姓名：");
                scanf("%s", s->name);
                printf("请输入课程名：");
                getchar();
                gets(s->course);
                if (InsertBST(&T, s))
                {
                    printf("✅ 插入成功！\n");
                }
                break;

            case 5:
                printf("请输入要删除（退选）的学号：");
                scanf("%d", &key);
                if (DeleteBST(&T, key))
                {
                    printf("✅ 删除成功！\n");
                }
                else
                {
                    printf("❌ 删除失败，不存在该学号！\n");
                }
                break;

            case 0:
                printf("程序退出，再见！\n");
                return 0;

            default:
                printf("❌ 选项错误，请重新输入！\n");
        }
    }
    return 0;
}
